{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env main.ts",
    "test": "deno test --allow-read --allow-env",
    "check": "deno check main.ts tests/"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.16",
    "@hono/zod-validator": "jsr:@hono/zod-validator@^0.9.1",
    "zod": "npm:zod@^4.6.7",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100
  }
}
